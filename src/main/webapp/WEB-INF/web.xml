<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0" metadata-complete="true">

    <display-name>Acme Payroll</display-name>

    <listener>
        <listener-class>com.acme.payroll.listener.AppContextListener</listener-class>
    </listener>

    <!-- Filters -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>com.acme.payroll.web.filter.EncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter>
        <filter-name>authFilter</filter-name>
        <filter-class>com.acme.payroll.web.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- Servlets -->
    <servlet>
        <servlet-name>login</servlet-name>
        <servlet-class>com.acme.payroll.web.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>logout</servlet-name>
        <servlet-class>com.acme.payroll.web.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>dashboard</servlet-name>
        <servlet-class>com.acme.payroll.web.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>employees</servlet-name>
        <servlet-class>com.acme.payroll.web.servlet.EmployeeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>timesheets</servlet-name>
        <servlet-class>com.acme.payroll.web.servlet.TimesheetServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>payruns</servlet-name>
        <servlet-class>com.acme.payroll.web.servlet.PayRunServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>payslips</servlet-name>
        <servlet-class>com.acme.payroll.web.servlet.PayslipServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>departments</servlet-name>
        <servlet-class>com.acme.payroll.web.servlet.DepartmentServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>reports</servlet-name>
        <servlet-class>com.acme.payroll.web.servlet.ReportServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>admin</servlet-name>
        <servlet-class>com.acme.payroll.web.servlet.AdminServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>login</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>logout</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>dashboard</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>employees</servlet-name>
        <url-pattern>/employees/*</url-pattern>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>timesheets</servlet-name>
        <url-pattern>/timesheets/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>payruns</servlet-name>
        <url-pattern>/payruns/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>payslips</servlet-name>
        <url-pattern>/payslips/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>departments</servlet-name>
        <url-pattern>/departments/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>reports</servlet-name>
        <url-pattern>/reports/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>admin</servlet-name>
        <url-pattern>/admin/*</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
</web-app>
